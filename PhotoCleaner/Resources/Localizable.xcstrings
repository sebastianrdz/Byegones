{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.page1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe your way clean"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia deslizando"
          }
        }
      }
    },
    "onboarding.page1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left to delete. Right to keep. Up to favorite ★. Oops? Undo brings it right back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Izquierda para borrar. Derecha para guardar. Arriba para marcar como favorita ★. ¿Te equivocaste? Deshacer la recupera."
          }
        }
      }
    },
    "onboarding.page1.demo.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar"
          }
        }
      }
    },
    "onboarding.page1.demo.keep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar"
          }
        }
      }
    },
    "onboarding.page1.demo.favorite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorite"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorita"
          }
        }
      }
    },
    "onboarding.page1.demo.a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: swipe left to delete, right to keep, up to favorite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demostración: desliza a la izquierda para borrar, a la derecha para guardar, arriba para favorita."
          }
        }
      }
    },
    "onboarding.page2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos never leave your iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos nunca salen de tu iPhone"
          }
        }
      }
    },
    "onboarding.page2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account. No tracking. No data collected. Everything happens right here on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta. Sin rastreo. No recopilamos datos. Todo ocurre aquí, en tu dispositivo."
          }
        }
      }
    },
    "onboarding.page3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's find your photos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busquemos tus fotos"
          }
        }
      }
    },
    "onboarding.page3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rollaway needs access to your photo library to show them to you. Nothing is deleted until you review your pile and confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rollaway necesita acceso a tu fototeca para mostrártelas. No se borra nada hasta que revises tu pila y confirmes."
          }
        }
      }
    },
    "onboarding.next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiente"
          }
        }
      }
    },
    "onboarding.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow photo access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acceso a Fotos"
          }
        }
      }
    },

        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasan a Eliminados recientemente en Fotos y se quedan ahí 30 días. Para recuperar el espacio ya: Fotos > Álbumes > Eliminados recientemente > Seleccionar > Eliminar todo."
          }
        }
      }
    },

    "permission.restricted.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access is restricted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Fotos está restringido"
          }
        }
      }
    },
    "permission.restricted.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone doesn't allow Rollaway to use photos. Check Screen Time or your device settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no permite que Rollaway use las fotos. Revisa Tiempo en pantalla o los ajustes del dispositivo."
          }
        }
      }
    },

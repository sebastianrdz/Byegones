    },
    "permission.denied.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access is off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Fotos está desactivado"
          }
        }
      }
    },
    "permission.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rollaway can't show your photos without access. Turn it on in Settings, then come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rollaway no puede mostrar tus fotos sin acceso. Actívalo en Ajustes y vuelve."
          }
        }
      }
    },
    "permission.denied.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes"
          }
        }
      }
    },
    "permission.limited.banner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're sharing only some photos with Rollaway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo compartes algunas fotos con Rollaway."
          }
        }
